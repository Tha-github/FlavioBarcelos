---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Heading from '../components/Heading.astro';
import { paginasLegais, inventarioCookies } from '../content/paginasLegais';
import { politicas } from '../content/politicas';
import Footer from '../components/Footer.astro';

export function getStaticPaths() {
  return paginasLegais.map((pagina) => ({ params: { documento: pagina.slug }, props: pagina }));
}
const { titulo, secoes, slug } = Astro.props;
---

<BaseLayout title={titulo}>
  <Container class="py-section">
    <Heading nivel={1}>{titulo}</Heading>
    <p class="mt-6 font-bold">[CONFIRMAR — revisão jurídica]</p>
    <p class="mt-3 text-step--1">
      Última atualização:{' '}
      <time datetime={politicas.atualizacao}>
        {politicas.atualizacao.split('-').reverse().join('/')}
      </time>{' '}
      · Versão {politicas.versao}
    </p>
    <div class="mt-10 max-w-[70ch] space-y-10">
      {secoes.map((secao) => (
        <section>
          <Heading nivel={2} tamanho="h3">
            {secao.titulo}
          </Heading>
          {secao.paragrafos.map((texto) => (
            <p class="mt-4">{texto}</p>
          ))}
        </section>
      ))}
    </div>
    {slug === 'politica-de-cookies' && (
      <section class="mt-10">
        <Heading nivel={2} tamanho="h3">
          Inventário de cookies e serviços
        </Heading>
        <div class="mt-5 overflow-x-auto">
          <table class="w-full min-w-[40rem] text-left text-step--1">
            <caption class="sr-only">Categorias, serviços, finalidades e duração</caption>
            <thead>
              <tr>
                {['Categoria', 'Cookie ou serviço', 'Finalidade', 'Duração'].map((coluna) => (
                  <th scope="col" class="border-b border-champagne p-3">
                    {coluna}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {inventarioCookies.map((item) => (
                <tr>
                  {[item.categoria, item.nome, item.finalidade, item.prazo].map((valor) => (
                    <td class="border-b border-champagne/40 p-3 align-top">{valor}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}
    <a href="/" class="mt-8 inline-block underline underline-offset-4">
      Voltar para o início
    </a>
  </Container>
  <Footer slot="footer" />
</BaseLayout>
