---
import { site } from '../content';
import { hora } from '../lib/contato';
const dias = ['Domingo', 'Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado'];
// Faixa contínua vira "Segunda a sábado"; um dia só ou dias soltos ficam com o nome completo.
const rotulo = (lista: readonly number[]) => {
  const nomes = lista.map((d) => dias[d] ?? '');
  const primeiro = nomes[0] ?? '';
  if (nomes.length < 2) return primeiro;
  const ultimo = (nomes[nomes.length - 1] ?? '').toLowerCase();
  return `${primeiro} a ${ultimo}`;
};
---

<ul class="space-y-1">
  {site.horarios.map((horario) => (
    <li>
      <strong class="font-bold">{rotulo(horario.dias)}:</strong> das{' '}
      <time datetime={horario.abre}>{hora(horario.abre)}</time> às{' '}
      <time datetime={horario.fecha}>{hora(horario.fecha)}</time>
    </li>
  ))}
  {site.diasFechados.map((dia) => (
    <li>
      <strong class="font-bold">{dias[dia]}:</strong> fechado
    </li>
  ))}
</ul>
