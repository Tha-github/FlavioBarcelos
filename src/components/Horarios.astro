---
import { site } from '../content';
const dias = [
  'Domingo',
  'Segunda-feira',
  'Terça-feira',
  'Quarta-feira',
  'Quinta-feira',
  'Sexta-feira',
  'Sábado',
];
---

<ul class="space-y-1">
  {site.horarios.map((horario) => (
    <li>
      {horario.dias.map((dia) => dias[dia]).join(', ')}:{' '}
      <time datetime={horario.abre}>{horario.abre}</time> às{' '}
      <time datetime={horario.fecha}>{horario.fecha}</time>.
    </li>
  ))}
  {site.diasFechados.map((dia) => (
    <li>{dias[dia]}: fechado.</li>
  ))}
</ul>
