---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../content';
import Section from './Section.astro';
import Container from './Container.astro';
import Heading from './Heading.astro';
import CTAAgendar from './CTAAgendar.astro';

// Duas imagens 4:5 em src/assets/foco/: foco-1.jpg (antes) e foco-2.jpg (depois); também png, webp ou avif.
// Enquanto o arquivo real não existir, vale o placeholder foco-N-placeholder.webp.
const arquivos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/foco/foco-*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const imagens = [1, 2].flatMap((n) => {
  const nomeDe = (k: string) => k.split('/').pop() ?? '';
  const chaves = Object.keys(arquivos);
  const real = chaves.find((k) => nomeDe(k).startsWith(`foco-${n}.`));
  const placeholder = chaves.find((k) => nomeDe(k).startsWith(`foco-${n}-placeholder.`));
  const chave = real ?? placeholder;
  const meta = chave ? arquivos[chave]?.default : undefined;
  return meta ? [{ n, meta }] : [];
});
---

<Section tema="stone" aria-labelledby="cabelos">
  <Container>
    <Heading nivel={2} id="cabelos">
      Cabelos by Flávio Barcelos
    </Heading>
    <p class="text-step-0 mt-6">
      Antes de qualquer procedimento químico, Flávio avalia as condições do seu cabelo para entender
      suas necessidades e indicar o tratamento mais adequado. A avaliação pode ser realizada
      presencialmente ou pelo WhatsApp, trazendo mais segurança e confiança antes de qualquer
      transformação.
    </p>
    <div class="mx-auto mt-12 flex max-w-3xl items-center justify-center gap-3 md:gap-6">
      <!-- "Antes" fica à esquerda e "Depois" à direita; o sentido da palavra acompanha a lateral. -->
      <span
        class="font-display text-step-2 md:text-step-3 tracking-titulo [writing-mode:vertical-rl] rotate-180"
        aria-hidden="true"
      >
        Antes
      </span>
      <ul class="grid min-w-0 flex-1 grid-cols-2 gap-3 md:gap-6">
        {imagens.map(({ n, meta }) => (
          <li>
            <Picture
              src={meta}
              formats={['avif', 'webp']}
              widths={[240, 360, 480, 640]}
              sizes="(min-width: 768px) 320px, 45vw"
              alt={site.focoAlts[n - 1] ?? ''}
              width={meta.width}
              height={meta.height}
              loading="lazy"
              decoding="async"
              class="aspect-[4/5] h-auto w-full object-cover"
            />
          </li>
        ))}
      </ul>
      <span
        class="font-display text-step-2 md:text-step-3 tracking-titulo [writing-mode:vertical-rl]"
        aria-hidden="true"
      >
        Depois
      </span>
    </div>
    <CTAAgendar secao="cabelo-foco" />
  </Container>
</Section>
