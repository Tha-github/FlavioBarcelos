---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../content';
import Section from './Section.astro';
import Container from './Container.astro';
import Heading from './Heading.astro';
import CTAAgendar from './CTAAgendar.astro';

// Imagens 4:5 em src/assets/foco/: foco-1.jpg (ou png, webp, avif), foco-2.* e foco-3.*.
// Enquanto o arquivo real não existir, vale o placeholder foco-N-placeholder.webp.
const arquivos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/foco/foco-*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const imagens = [1, 2, 3].flatMap((n) => {
  const nomeDe = (k: string) => k.split('/').pop() ?? '';
  const chaves = Object.keys(arquivos);
  const real = chaves.find((k) => nomeDe(k).startsWith(`foco-${n}.`));
  const placeholder = chaves.find((k) => nomeDe(k).startsWith(`foco-${n}-placeholder.`));
  const chave = real ?? placeholder;
  const meta = chave ? arquivos[chave]?.default : undefined;
  return meta ? [{ n, meta }] : [];
});
---

<Section fundo="pearl" aria-labelledby="cabelos">
  <Container>
    <!-- Sequência: hero em silk, então marble para separar. -->
    <Heading nivel={2} id="cabelos">
      Cabelo é o nosso foco
    </Heading>
    <p class="text-step-1 mt-6">
      Antes de qualquer química, olhamos o seu fio: o que ele precisa e o que ele aguenta. O
      atendimento é sem pressa e, no final, você leva a orientação para manter o resultado em casa.
    </p>
    <ul class="mx-auto mt-12 grid max-w-5xl grid-cols-2 gap-3 md:grid-cols-3 md:gap-6">
      {imagens.map(({ n, meta }) => (
        <li class={n === 1 ? 'col-span-2 md:col-span-1' : ''}>
          <Picture
            src={meta}
            formats={['avif', 'webp']}
            widths={[320, 480, 640, 800]}
            sizes={
              n === 1
                ? '(min-width: 1280px) 400px, (min-width: 768px) 33vw, 100vw'
                : '(min-width: 1280px) 400px, (min-width: 768px) 33vw, 50vw'
            }
            alt={site.focoAlts[n - 1] ?? ''}
            width={meta.width}
            height={meta.height}
            loading="lazy"
            decoding="async"
            class="aspect-[4/5] h-auto w-full object-cover"
          />
        </li>
      ))}
    </ul>
    <CTAAgendar secao="cabelo-foco" />
  </Container>
</Section>
