---
import Section from './Section.astro';
import Heading from './Heading.astro';
import Button from './Button.astro';
import PinceisFlutuantes from './PinceisFlutuantes.astro';
import { site } from '../content';
import { externo, linhaApoio } from '../lib/contato';
import { whatsappLink } from '../lib/whatsapp';
---

<!-- Hero em silk. Padding superior = altura do header fixo (64px mobile, 80px desktop) + ~32-40px. -->
<Section
  tema="silk"
  class="relative z-20 overflow-x-clip pt-[6rem]! pb-24! xl:pt-[7rem]! lg:pb-16!"
>
  <div class="max-w-site px-gutter relative mx-auto grid w-full gap-10 lg:grid-cols-12 lg:items-start lg:gap-8">
    <!-- LCP: placeholder 4:5. [CONFIRMAR — cliente vai escolher] Trocar por <Picture loading="eager" fetchpriority="high"> com a foto real. -->
    <div class="mx-auto w-4/5 sm:w-3/5 lg:order-2 lg:col-span-5 lg:col-start-8 lg:w-full">
      <div
        class="bg-velvet text-marble border-champagne/40 text-step--1 flex aspect-[4/5] w-full items-end border p-4 text-left"
        role="img"
        aria-label="Espaço reservado para a foto do Flávio Barcelos"
      >
        Foto vertical 4:5 [CONFIRMAR]
      </div>
    </div>

    <div class="lg:order-1 lg:col-span-7 lg:text-left">
      <Heading nivel={1} tamanho="display">
        Cabelos com cuidado no Centro do Rio
      </Heading>
      <p class="text-step-1 text-onyx mx-auto mt-6 max-w-[34ch] lg:mx-0">
        Especialista em loiras, corte, coloração e tratamento, com o cuidado do Flávio Barcelos.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4 lg:justify-start">
        <Button
          href={whatsappLink(site.mensagens.agendar)}
          {...externo}
          variante="primario"
          data-secao="hero"
        >
          Agendar horário<span class="sr-only"> (abre em nova aba)</span>
        </Button>
        <Button href="#servicos" variante="secundario">
          Ver serviços
        </Button>
      </div>
      <p class="text-step--1 text-onyx mx-auto mt-8 w-fit lg:mx-0">{linhaApoio()}</p>
    </div>
  </div>

  <PinceisFlutuantes />
</Section>
