---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { profissionais } from '../content';
import Section from './Section.astro';
import Container from './Container.astro';
import Heading from './Heading.astro';
import Button from './Button.astro';
import { externo } from '../lib/contato';

// Fotos 4:5 em src/assets/profissionais/, listadas em src/content/profissionais.json.
const modulos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/profissionais/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);

const itens = profissionais.map((p) => {
  const meta = modulos[`../assets/profissionais/${p.foto}`]?.default;
  if (!meta) {
    throw new Error(
      `profissionais.json: foto "${p.foto}" não existe em src/assets/profissionais/.`,
    );
  }
  return { ...p, meta };
});
---

<Section tema="stone" aria-labelledby="profissionais">
  <Container>
    <Heading nivel={2} id="profissionais">
      Profissionais do Estúdio Flávio Barcelos
    </Heading>
    <ul class="mt-12 flex flex-wrap justify-start gap-x-4 gap-y-10 md:gap-x-6 xl:gap-x-4">
      {itens.map((p) => (
        <li class="w-[calc((100%-1rem)/2)] md:w-[calc((100%-3rem)/3)] xl:w-[calc((100%-4rem)/5)]">
          <Picture
            src={p.meta}
            formats={['avif', 'webp']}
            widths={[200, 300, 400]}
            sizes="(min-width: 1280px) 220px, (min-width: 768px) 30vw, 45vw"
            alt={p.alt}
            width={p.meta.width}
            height={p.meta.height}
            loading="lazy"
            decoding="async"
            class="borda-ouro aspect-[4/5] h-auto w-full border object-cover"
            style={p.posicao ? `object-position: ${p.posicao}` : undefined}
          />
          <h3 class="font-display text-step-2 tracking-titulo mt-4 text-balance">{p.nome}</h3>
          <p class="mt-1 text-xs leading-snug text-balance">{p.area}</p>
          {p.instagram && (
            <Button
              href={p.instagram}
              {...externo}
              variante="secundario"
              class="mt-4 px-6 py-2.5 text-sm"
              data-secao={`profissional-${p.id}`}
            >
              Saber mais<span class="sr-only"> sobre {p.nome} no Instagram (abre em nova aba)</span>
            </Button>
          )}
        </li>
      ))}
    </ul>
  </Container>
</Section>
