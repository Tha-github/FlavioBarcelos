---
import Section from './Section.astro';
import Container from './Container.astro';
import Heading from './Heading.astro';
import CTAAgendar from './CTAAgendar.astro';
import ComoFuncionaCarrossel from './ComoFuncionaCarrossel';

// Sequência real do atendimento. [CONFIRMAR] com o Flávio se o fluxo descrito é exatamente este.
const passos = [
  {
    titulo: 'Conversa e diagnóstico',
    texto: 'Ouvimos o que você quer e avaliamos o estado do fio antes de qualquer química.',
  },
  {
    titulo: 'Proposta e orçamento',
    texto: 'Você conhece o plano do serviço e o valor antes de começarmos.',
  },
  {
    titulo: 'Execução',
    texto: 'O serviço é feito com calma, e você acompanha cada etapa.',
  },
  {
    titulo: 'Orientação de manutenção em casa',
    texto: 'Você sai sabendo como cuidar do resultado no dia a dia.',
  },
];
---

<Section fundo="pearl" aria-labelledby="como-funciona">
  <Container>
    <Heading nivel={2} id="como-funciona">
      Como funciona o atendimento
    </Heading>
    <div class="mt-12">
      <ComoFuncionaCarrossel client:visible passos={passos} />
    </div>
    <!-- Sem JavaScript, os passos aparecem empilhados. -->
    <noscript>
      <style>
        .como-trilha {
          display: block !important;
          transform: none !important;
        }
        .como-trilha > li {
          width: auto !important;
          margin-bottom: 2rem;
        }
        .como-controles {
          display: none !important;
        }
      </style>
    </noscript>
    <CTAAgendar secao="como-funciona" />
  </Container>
</Section>
