---
import { servicos } from '../content';
import { mensagemServico, whatsappLink } from '../lib/whatsapp';
import Section from './Section.astro';
import Container from './Container.astro';
import Heading from './Heading.astro';
import BoxServico from './BoxServico.astro';

const lista = servicos.filter((servico) => servico.categoria === 'espaco');
---

<Section fundo="pearl" aria-labelledby="outros-servicos">
  <Container>
    <Heading nivel={2} id="outros-servicos">
      Além dos cabelos
    </Heading>
    <p class="mt-6">
      Manicure, pedicure, depilação e massagens relaxantes para um cuidado completo.
    </p>
    <div class="mt-12 flex flex-wrap justify-center gap-6">
      {lista.map((servico) => (
        <BoxServico
          nome={servico.nome}
          descricao={servico.descricao}
          fundo="marble"
          colunas={4}
          acao={{ href: whatsappLink(mensagemServico(servico.nome)) }}
        />
      ))}
    </div>
  </Container>
</Section>
