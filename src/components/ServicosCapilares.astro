---
import { servicos } from '../content';
import Section from './Section.astro';
import Container from './Container.astro';
import Heading from './Heading.astro';
import BoxServico from './BoxServico.astro';
import CTAAgendar from './CTAAgendar.astro';

const lista = servicos.filter((s) => s.categoria === 'outros');
---

<Section tema="preto" aria-labelledby="servicos">
  <Container>
    <Heading nivel={2} id="servicos">
      Outros Serviços
    </Heading>
    <p class="text-step-0 mt-6">
      Um espaço pensado para valorizar sua beleza e proporcionar uma experiência completa de cuidado
      e bem-estar, no coração do Rio desde 2020.
    </p>
    <div class="mt-12 flex flex-wrap justify-center gap-6">
      {lista.map((s) => (
        <BoxServico nome={s.nome} descricao={s.descricao} tema="preto" />
      ))}
    </div>
    <CTAAgendar secao="servicos-capilares" />
  </Container>
</Section>
