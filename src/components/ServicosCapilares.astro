---
import { servicos } from '../content';
import Section from './Section.astro';
import Container from './Container.astro';
import Heading from './Heading.astro';
import BoxServico from './BoxServico.astro';
import CTAAgendar from './CTAAgendar.astro';

const lista = servicos.filter((s) => s.categoria === 'cabelo');
---

<Section fundo="marble" aria-labelledby="servicos">
  <Container>
    <Heading nivel={2} id="servicos">
      Serviços capilares
    </Heading>
    <p class="mt-6">
      Cortes modernos, coloração vibrante, mechas e técnicas avançadas de aplicação de cor, no
      coração do Rio desde 2020.
    </p>
    <div class="mt-12 flex flex-wrap justify-center gap-6">
      {lista.map((s) => (
        <BoxServico nome={s.nome} descricao={s.descricao} fundo="pearl" />
      ))}
    </div>
    <CTAAgendar secao="servicos-capilares" />
  </Container>
</Section>
