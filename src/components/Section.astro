---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
  /** preto: fundo preto com texto branco. stone: fundo areia (#d8d4c9) com texto preto. */
  tema?: 'preto' | 'stone';
}

const { tema = 'stone', class: className, ...rest } = Astro.props;

const temas = {
  preto: 'tema-preto bg-onyx text-pearl',
  stone: 'tema-stone bg-stone text-onyx',
} as const;
---

<section class:list={[temas[tema], 'py-section text-center', className]} {...rest}>
  <slot />
</section>
