---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
  /** Tema da seção: define fundo, cor do texto e cor do foco. */
  tema?: 'claro' | 'escuro' | 'silk';
  /** Fundo da seção clara (alternância). Ignorado no tema escuro. */
  fundo?: 'pearl' | 'marble';
}

const { tema = 'claro', fundo = 'pearl', class: className, ...rest } = Astro.props;

const temas = {
  escuro: 'tema-escuro bg-velvet text-pearl',
  silk: 'tema-silk bg-silk text-onyx',
  pearl: 'tema-claro bg-pearl text-onyx',
  marble: 'tema-claro bg-marble text-onyx',
} as const;

const classes = tema === 'claro' ? temas[fundo] : temas[tema];
---

<section class:list={[classes, 'py-section text-center', className]} {...rest}>
  <slot />
</section>
