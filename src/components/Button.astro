---
import type { HTMLAttributes } from 'astro/types';

interface BaseProps {
  /** primario-escuro: fundo onyx (sobre seções claras). primario-claro: fundo pearl e secundario-claro: contorno (ambos sobre seções escuras). */
  variante?:
    'primario' | 'secundario' | 'primario-escuro' | 'primario-claro' | 'secundario-claro' | 'link';
  class?: string;
}

type LinkProps = BaseProps & Omit<HTMLAttributes<'a'>, 'class'> & { href: string };
type ButtonProps = BaseProps &
  Omit<HTMLAttributes<'button'>, 'class'> & {
    href?: undefined;
    type?: 'button' | 'submit' | 'reset';
  };

type Props = LinkProps | ButtonProps;

const { variante = 'primario-escuro', class: className, href, ...rest } = Astro.props;
const { type = 'button', ...botao } = rest as HTMLAttributes<'button'>;

const base =
  'inline-flex items-center justify-center gap-2 font-sans font-medium transition-colors duration-200 cursor-pointer';

const variantes = {
  // Sobre fundos claros e silk: marrom (velvet) com texto silk.
  primario: 'rounded-full bg-velvet px-8 py-3.5 text-silk hover:bg-onyx',
  secundario:
    'rounded-full border-[1.5px] border-velvet bg-transparent px-8 py-3.5 text-velvet hover:bg-velvet hover:text-silk',
  'primario-escuro': 'rounded-full bg-velvet px-8 py-3.5 text-pearl hover:bg-onyx',
  'primario-claro': 'rounded-full bg-pearl px-8 py-3.5 text-onyx hover:bg-marble',
  'secundario-claro': 'rounded-full border border-marble/60 px-8 py-3.5 text-pearl hover:bg-velvet',
  link: 'px-0 py-1 underline decoration-1 underline-offset-[0.35em] hover:decoration-2',
} as const;

const classes = [base, variantes[variante], className];
---

{href ? (
  <a class:list={classes} href={href} {...(rest as HTMLAttributes<'a'>)}>
    <slot />
  </a>
) : (
  <button class:list={classes} type={type} {...botao}>
    <slot />
  </button>
)}
