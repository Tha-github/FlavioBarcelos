---
import type { HTMLAttributes } from 'astro/types';

interface BaseProps {
  /** primario: dourado com gradiente e texto preto. secundario: contorno dourado com gradiente; o botão inteiro fica dourado ao passar o mouse. Os demais nomes são apelidos. */
  variante?:
    'primario' | 'secundario' | 'primario-escuro' | 'primario-claro' | 'secundario-claro' | 'link';
  class?: string;
}

type LinkProps = BaseProps & Omit<HTMLAttributes<'a'>, 'class'> & { href: string };
type ButtonProps = BaseProps &
  Omit<HTMLAttributes<'button'>, 'class'> & {
    href?: undefined;
    type?: 'button' | 'submit' | 'reset';
  };

type Props = LinkProps | ButtonProps;

const { variante = 'primario', class: className, href, ...rest } = Astro.props;
const { type = 'button', ...botao } = rest as HTMLAttributes<'button'>;

const base =
  'inline-flex items-center justify-center gap-2 font-sans font-medium transition-colors duration-200 cursor-pointer';

// Primário: dourado com gradiente (cores do logo) e texto preto. Secundário: contorno dourado com gradiente e texto na cor da seção.
const primario = 'btn-ouro rounded-full px-8 py-3.5 text-onyx';
const secundario =
  'anel-ouro btn-ouro-hover relative [--anel:1.5px] rounded-full bg-transparent px-8 py-3.5 text-fg hover:text-onyx';
const variantes = {
  primario,
  secundario,
  'primario-escuro': primario,
  'primario-claro': primario,
  'secundario-claro': secundario,
  link: 'px-0 py-1 underline decoration-1 underline-offset-[0.35em] hover:decoration-2',
} as const;

const classes = [base, variantes[variante], className];
---

{href ? (
  <a class:list={classes} href={href} {...(rest as HTMLAttributes<'a'>)}>
    <slot />
  </a>
) : (
  <button class:list={classes} type={type} {...botao}>
    <slot />
  </button>
)}
