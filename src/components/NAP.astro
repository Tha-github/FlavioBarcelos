---
import { site } from '../content';
import { enderecoCompleto, externo } from '../lib/contato';
import { whatsappLink } from '../lib/whatsapp';
---

<address class="not-italic" data-nap>
  <p class="font-medium">{site.nome}</p>
  <p class="mt-2">{enderecoCompleto()}</p>
  <p class="mt-2">
    WhatsApp:{' '}
    <a
      class="text-velvet inline-flex min-h-11 items-center underline underline-offset-4"
      href={whatsappLink(site.mensagens.informacoes)}
      {...externo}
      aria-label={`Falar no WhatsApp: ${site.telefone} (abre em nova aba)`}
    >
      {site.telefone}
    </a>
  </p>
</address>
