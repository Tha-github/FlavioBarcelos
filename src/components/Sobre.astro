---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../content';
import Section from './Section.astro';
import Container from './Container.astro';
import Heading from './Heading.astro';
import CTAAgendar from './CTAAgendar.astro';

// Retrato 4:5: src/assets/sobre/retrato.jpg (ou png, webp, avif). Sem o arquivo real, vale o placeholder.
const arquivos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/sobre/retrato*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const nomeDe = (k: string) => k.split('/').pop() ?? '';
const chaves = Object.keys(arquivos);
const real = chaves.find((k) => nomeDe(k).startsWith('retrato.'));
const chave = real ?? chaves.find((k) => nomeDe(k).startsWith('retrato-placeholder.'));
const retrato = chave ? arquivos[chave]?.default : undefined;
---

<Section fundo="marble" aria-labelledby="sobre">
  <Container>
    {retrato && (
      <figure class="mx-auto w-full max-w-sm">
        <Picture
          src={retrato}
          formats={['avif', 'webp']}
          widths={[320, 480, 800]}
          sizes="(min-width: 640px) 384px, 100vw"
          alt={site.sobre.retratoAlt}
          width={retrato.width}
          height={retrato.height}
          loading="lazy"
          class="border-champagne/40 h-auto w-full border"
        />
        {!real && <figcaption class="text-step--1 mt-2">Retrato 4:5 [CONFIRMAR]</figcaption>}
      </figure>
    )}
    <Heading nivel={2} id="sobre" class="mt-10">
      {site.sobre.nome}
    </Heading>
    <p class="mt-6">{site.sobre.bio}</p>
    <ul class="divide-champagne/40 border-champagne/40 mx-auto mt-8 max-w-xl divide-y border-y">
      {site.sobre.fatos.map((fato) => (
        <li class="py-3">{fato}</li>
      ))}
    </ul>
    <blockquote class="font-display text-step-2 mx-auto mt-10 max-w-xl">
      <p>{site.sobre.citacao}</p>
    </blockquote>
    <CTAAgendar secao="sobre" />
  </Container>
</Section>
