---
// Logo provisório (placeholder). Substituir pelo SVG oficial quando fornecido [CONFIRMAR].
import { site } from '../content/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-3', className]}>
  <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true" class="shrink-0">
    <path
      d="M4 24C4 12 12 6 24 4M8 26C8 16 15 10 26 8"
      stroke="var(--velvet)"
      stroke-width="1.25"
      stroke-linecap="round"
    ></path>
  </svg>
  <span class="font-display text-step-1 tracking-titulo leading-none">{site.nome}</span>
</span>
