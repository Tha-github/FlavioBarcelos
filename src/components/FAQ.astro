---
import { faq } from '../content';
import Section from './Section.astro';
import Container from './Container.astro';
import Heading from './Heading.astro';
import CTAAgendar from './CTAAgendar.astro';
---

<Section tema="preto" aria-labelledby="faq">
  <Container>
    <Heading nivel={2} id="faq">
      Perguntas frequentes
    </Heading>
    <div class="mx-auto mt-10 max-w-3xl text-left">
      {faq.map((item) => (
        <details class="borda-ouro border-t py-5 last:border-b">
          <summary class="cursor-pointer font-medium">{item.pergunta}</summary>
          <p class="mt-4">{item.resposta}</p>
        </details>
      ))}
    </div>
    <CTAAgendar secao="faq" />
  </Container>
</Section>
