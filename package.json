{
  "name": "studio-flavio-barcelos",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:encoding && npm run check:galeria && astro build && node scripts/security-headers.mjs && node scripts/publicar-raiz.mjs",
    "test:security": "tsx --test tests/security.test.ts",
    "test:e2e": "playwright test",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:galeria": "node scripts/check-galeria.mjs",
    "publicar:raiz": "node scripts/publicar-raiz.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
